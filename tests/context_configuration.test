#!/usr/bin/env tclsh
# context_configuration.test -- Native context options and model characteristics.
# Tests requested/effective separation and replacement-context persistence.
# Requires Tcl 8.6, tcltest, tclllama 0.1.0 and optional TCLLLAMA_TEST_MODEL.
set packageDir [file normalize [expr {$argc ? [lindex $argv 0] : "build/local"}]]
set argv {}; set argc 0
package require tcltest 2
namespace import ::tcltest::test
lappend auto_path $packageDir
package require tclllama 0.1.0
::tcltest::testConstraint model [info exists ::env(TCLLLAMA_TEST_MODEL)]

# options is a context-option list; returns true only for pre-load validation
# rejection. A missing model-file error does not count as successful validation.
proc contextRejected {options} {
    set code [catch {llama::init /nonexistent-model.gguf 512 -options $options} message]
    expr {$code && $message ne "Failed to load model"}
}

test context-configuration-1.1 {Invalid scalar inputs reject before model loading} -body {
    set results {}
    foreach options {
        {n_outputs_max -1} {n_batch 8 n_outputs_max 9}
        {n_seq_max 2 n_outputs_max 1} {n_outputs_max_per_seq -1}
        {rope_scaling_type 3} {rope_scaling_type 99}
        {pooling_type 1} {attention_type 1} {flash_attn_type 2}
        {flash_attn 0 flash_attn_type 0}
        {rope_freq_base 1} {rope_freq_base -1} {rope_freq_base Inf}
        {rope_freq_scale -1} {rope_freq_scale NaN} {rope_freq_scale 1e-100}
        {yarn_beta_fast 0} {yarn_attn_factor 0} {yarn_beta_slow Inf}
        {yarn_orig_ctx -1} {yarn_orig_ctx 2147483648}
        {type_k q4_0} {type_v invalid} {no_perf invalid}
    } {lappend results [contextRejected $options]}
    expr {[lsearch -exact $results 0] < 0}
} -result 1

test context-configuration-1.2 {Native defaults and model characteristics preserve existing keys} -constraints model -body {
    set h [llama::init $::env(TCLLLAMA_TEST_MODEL) 512 -options {n_threads 2 n_threads_batch 2}]
    try {
        set info [llama::info $h]
        set req [dict get $info context requested]
        set eff [dict get $info context effective]
        set m [dict get $info model]
        set numeric 1
        foreach key {n_embd_out n_layer_nextn n_head n_head_kv n_swa rope_type decoder_start_token} {
            if {![string is integer -strict [dict get $m $key]]} {set numeric 0}
        }
        list [dict get $req n_outputs_max] [dict get $req n_outputs_max_per_seq] \
            [dict get $req type_k] [dict get $req rope_scaling_type] \
            [dict get $eff causal_attn] [llama::context_control $h causal_attn] \
            [expr {[dict get $eff n_ctx] == [dict get $info n_ctx]}] $numeric \
            [string is double -strict [dict get $m rope_freq_scale_train]] \
            [expr {[string length [dict get $m chat_template]] > 0}]
    } finally {llama::free $h}
} -result {0 1 f16 -1 1 1 1 1 1 1}

test context-configuration-1.3 {Independent context settings survive native and snapshot restoration and memory edits} -constraints model -body {
    set m [llama::model_load $::env(TCLLLAMA_TEST_MODEL)]
    set a [llama::context_create $m 512 -options {
        n_threads 2 n_threads_batch 2 n_batch 32 n_ubatch 16
        n_outputs_max 8 n_outputs_max_per_seq 0
        attention_type 0 pooling_type 0 flash_attn_type 0
        rope_scaling_type 1 rope_freq_base 10000 rope_freq_scale 0.5
        yarn_ext_factor 0 yarn_attn_factor 1 yarn_beta_fast 32 yarn_beta_slow 1 yarn_orig_ctx 512
        type_k f32 type_v f32 no_perf false
    }]
    set b [llama::context_create $m 512 -options {n_threads 2 n_threads_batch 2}]
    try {
        set trainingBefore [dict get [llama::info $b] model n_ctx_train]
        set badYarn [catch {llama::context_create $m 512 -options {rope_scaling_type 2 rope_freq_scale 0.5}}]
        if {!$badYarn || $trainingBefore != [dict get [llama::info $b] model n_ctx_train]} {error "YaRN changed shared model"}
        set requested [dict get [llama::info $a] context requested]
        llama::prefill $a {1 2 3 4}
        set bytes [llama::state_get $a]
        set incompatible [catch {llama::state_set $b $bytes}]
        if {!$incompatible || [llama::get_context $b] != 0} {error "incompatible cache type changed destination context"}
        llama::state_set $a $bytes
        llama::generate $a {new input} -max_tokens 1
        llama::snapshot_save $a
        llama::sequence $a memory rm 0 2 -1
        llama::prefill $a {5}
        llama::snapshot_restore $a
        llama::generate $a {another input} -max_tokens 1
        list [expr {$requested eq [dict get [llama::info $a] context requested]}] \
            [dict get [llama::info $b] context requested type_k] \
            [llama::get_context $b] [dict get [llama::info $a] context effective pooling_type]
    } finally {llama::context_free $a; llama::context_free $b; llama::model_free $m}
} -result {1 f16 0 0}

test context-configuration-1.4 {YaRN configuration executes through native decoding and state restoration} -constraints model -body {
    set h [llama::init $::env(TCLLLAMA_TEST_MODEL) 512 -options {
        n_threads 2 n_threads_batch 2 rope_scaling_type 2 rope_freq_scale 0
        yarn_ext_factor 1 yarn_attn_factor 1 yarn_beta_fast 32 yarn_beta_slow 1 yarn_orig_ctx 512
    }]
    try {
        llama::prefill $h {1 2 3}
        llama::snapshot_save $h
        llama::generate $h hello -max_tokens 1
        llama::snapshot_restore $h
        llama::generate $h again -max_tokens 1
        set request [dict get [llama::info $h] context requested]
        list [dict get $request rope_scaling_type] [dict get $request yarn_orig_ctx] \
            [expr {[llama::get_context $h] > 3}]
    } finally {llama::free $h}
} -result {2 512 1}
::tcltest::cleanupTests
