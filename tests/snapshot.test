#!/usr/bin/env tclsh
# snapshot.test -- Per-handle inference snapshot and lifecycle checks.
# Usage: TCLLLAMA_TEST_MODEL=/path/model.gguf tclsh tests/snapshot.test build/local
# Requires Tcl 8.6, tcltest and the built tclllama package.
set packageDir [file normalize [expr {$argc ? [lindex $argv 0] : "build/local"}]]
set argv {}
set argc 0
package require tcltest 2
namespace import ::tcltest::test
lappend auto_path $packageDir
package require tclllama 7.5
::tcltest::testConstraint model [expr {[info exists ::env(TCLLLAMA_TEST_MODEL)] && [file isfile $::env(TCLLLAMA_TEST_MODEL)]}]

# Called by generation; snapshot operations on an active handle must fail.
proc snapshotBusyCallback {fragment} {
    set ::snapshotBusy [catch {llama::snapshot_restore $::snapshotHandle} ::snapshotBusyMessage]
}

test snapshot-1.1 {Restore sampler, parameters, positions and deterministic continuation} -constraints model -body {
    set h [llama::init $::env(TCLLLAMA_TEST_MODEL) 512 -options {n_threads 2 n_threads_batch 2}]
    try {
        llama::generate $h Hello -options {seed 42 temperature 0.8 top_k 40} -max_tokens 4
        set position [llama::get_context $h]
        set bytes [llama::snapshot_save $h]
        set expected [llama::generate $h { again}]
        llama::generate $h { different} -options {temperature 0.1} -max_tokens 2
        llama::snapshot_restore $h
        set restored [llama::get_context $h]
        set temp [dict get [llama::info $h] sampling temperature]
        set actual [llama::generate $h { again}]
        set replaced [llama::snapshot_save $h]
        llama::snapshot_discard $h
        set before [llama::get_context $h]
        set failed [catch {llama::snapshot_restore $h} message]
        list [expr {$bytes > 0 && $replaced > 0}] [expr {$position == $restored}] \
            [expr {abs($temp - 0.8) < 0.001}] [expr {$expected eq $actual}] \
            $failed $message [expr {$before == [llama::get_context $h]}]
    } finally {
        llama::free $h
    }
} -result {1 1 1 1 1 {No snapshot saved for handle} 1}

test snapshot-1.2 {Snapshot is private and operations reject busy handle} -constraints model -body {
    set h [llama::init $::env(TCLLLAMA_TEST_MODEL) 512]
    set other [llama::init $::env(TCLLLAMA_TEST_MODEL) 512]
    try {
        llama::snapshot_save $h
        set foreign [catch {llama::snapshot_restore $other} message]
        set ::snapshotHandle $h
        set ::snapshotBusy 0
        llama::generate $h Hello -max_tokens 2 -callback snapshotBusyCallback
        list $foreign $message $::snapshotBusy $::snapshotBusyMessage
    } finally {
        llama::free $other
        llama::free $h
    }
} -result {1 {No snapshot saved for handle} 1 {Handle is busy}}

set failed $::tcltest::numTests(Failed)
::tcltest::cleanupTests
exit [expr {$failed > 0}]
