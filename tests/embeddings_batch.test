#!/usr/bin/env tclsh
# -----------------------------------------------------------------------------
# embeddings_batch.test — Native batched embeddings and Float32 output
#
# Purpose: verify multi-sequence native embedding batches, vector association,
#          context reuse, capacity validation, and portable f32le byte arrays.
# Public API: llama::embedding_context_create, llama::embed, llama::embed_batch.
# Requirements: Tcl 8.6, tcltest, tclllama 7.5, and local GGUF fixtures supplied
#               through TCLLLAMA_TEST_EMBEDDING_MODEL / TCLLLAMA_TEST_DECODER_MODEL.
# -----------------------------------------------------------------------------

set packageDir [file normalize [expr {$argc ? [lindex $argv 0] : "build/local"}]]
set argv {}
set argc 0
package require tcltest 2
namespace import ::tcltest::test
lappend auto_path $packageDir
package require tclllama 7.5

::tcltest::testConstraint embeddingModel [expr {
    [info exists ::env(TCLLLAMA_TEST_EMBEDDING_MODEL)] &&
    [file isfile $::env(TCLLLAMA_TEST_EMBEDDING_MODEL)]
}]
::tcltest::testConstraint decoderModel [expr {
    [info exists ::env(TCLLLAMA_TEST_DECODER_MODEL)] &&
    [file isfile $::env(TCLLLAMA_TEST_DECODER_MODEL)]
}]
::tcltest::testConstraint nativeCallProbe [expr {
    [llength [info commands ::tclllama::test::embedding_eval_calls]] == 1
}]

namespace eval ::embeddingBatch {}

# Return the maximum coordinate-wise absolute difference between equal vectors.
proc ::embeddingBatch::maxAbsoluteDifference {left right} {
    if {[llength $left] != [llength $right]} {
        return Inf
    }
    set maximum 0.0
    foreach a $left b $right {
        set difference [expr {abs(double($a) - double($b))}]
        if {$difference > $maximum} {set maximum $difference}
    }
    return $maximum
}

# Decode explicitly little-endian IEEE-754 Float32 bytes using Tcl 8.6's `r` code.
proc ::embeddingBatch::decodeF32le {bytes} {
    binary scan $bytes r* values
    return $values
}
proc ::embeddingBatch::norm {values} {
    set sum 0.0
    foreach value $values {set sum [expr {$sum + double($value) * double($value)}]}
    return [expr {sqrt($sum)}]
}

test embeddings-batch-api-1.1 {Batch command is registered} -body {
    list [llength [info commands ::llama::embed_batch]]
} -result {1}

test embeddings-batch-native-1.1 {One native batch preserves order and matches individual vectors} \
        -constraints embeddingModel -body {
    set model [llama::model_load $::env(TCLLLAMA_TEST_EMBEDDING_MODEL)]
    set context {}
    try {
        set context [llama::embedding_context_create $model 512 -options {
            pooling_type model attention_type model n_threads 2
            n_threads_batch 2 n_batch 256 n_ubatch 256 n_seq_max 4
        }]
        set texts [list {A short English sentence.} {Texto en español: café, niño y árbol.} \
            {A third document with a few more words.}]
        set batch [llama::embed_batch $context $texts]
        set individual {}
        foreach text $texts {lappend individual [llama::embed $context $text]}
        set dimensions [dict get [llama::info $context] model n_embd_out]
        set matches 1
        foreach batched $batch single $individual {
            if {[llength $batched] != $dimensions ||
                [::embeddingBatch::maxAbsoluteDifference $batched $single] > 1.0e-4} {
                set matches 0
            }
        }
        set reordered [llama::embed_batch $context [lreverse $texts]]
        set repeated [llama::embed_batch $context [list [lindex $texts 0] [lindex $texts 0]]]
        set orderMatches [expr {
            [::embeddingBatch::maxAbsoluteDifference [lindex $batch 0] [lindex $reordered 2]] < 1.0e-4 &&
            [::embeddingBatch::maxAbsoluteDifference [lindex $batch 2] [lindex $reordered 0]] < 1.0e-4
        }]
        set duplicateMatches [expr {
            [::embeddingBatch::maxAbsoluteDifference [lindex $repeated 0] [lindex $repeated 1]] < 1.0e-5
        }]
        list [llength $batch] [expr {$dimensions > 0}] $matches $orderMatches $duplicateMatches \
            [dict get [llama::info $context] context_kind]
    } finally {
        if {$context ne {}} {llama::context_free $context}
        llama::model_free $model
    }
} -result {3 1 1 1 1 embedding}

test embeddings-batch-native-1.1a {Two texts use one native evaluation while individual calls use two} \
        -constraints {embeddingModel nativeCallProbe} -body {
    set model [llama::model_load $::env(TCLLLAMA_TEST_EMBEDDING_MODEL)]
    set context {}
    try {
        set context [llama::embedding_context_create $model 512 -options {
            pooling_type model attention_type model n_threads 2
            n_batch 256 n_ubatch 256 n_seq_max 2
        }]
        ::tclllama::test::embedding_eval_calls reset
        llama::embed_batch $context {{first batch input} {second batch input}}
        set batchCalls [::tclllama::test::embedding_eval_calls]
        ::tclllama::test::embedding_eval_calls reset
        llama::embed $context {first batch input}
        llama::embed $context {second batch input}
        set individualCalls [::tclllama::test::embedding_eval_calls]
        list $batchCalls $individualCalls
    } finally {
        if {$context ne {}} {llama::context_free $context}
        llama::model_free $model
    }
} -result {1 2}

test embeddings-batch-native-1.2 {Binary Float32 is little-endian, dimensioned and round-trips} \
        -constraints embeddingModel -body {
    set model [llama::model_load $::env(TCLLLAMA_TEST_EMBEDDING_MODEL)]
    set context {}
    try {
        set context [llama::embedding_context_create $model 512 -options {
            pooling_type model attention_type model n_threads 2 n_batch 256 n_ubatch 256 n_seq_max 2
        }]
        set texts [list {Float32 output one.} {Float32 salida dos.}]
        set vectors [llama::embed_batch $context $texts -normalize l2]
        set bytes [llama::embed_batch $context $texts -normalize l2 -format f32le]
        set firstSingle [llama::embed $context [lindex $texts 0] -normalize l2 -format f32le]
        set decoded [::embeddingBatch::decodeF32le [lindex $bytes 0]]
        set numeric [llama::embed $context [lindex $texts 0] -normalize l2]
        set dimension [dict get [llama::info $context] model n_embd_out]
        set sizeOK [expr {[string length [lindex $bytes 0]] == $dimension * 4 &&
            [string length $firstSingle] == $dimension * 4 && [llength $bytes] == 2}]
        set roundTrip [expr {
            [llength $decoded] == $dimension &&
            [::embeddingBatch::maxAbsoluteDifference $decoded [lindex $vectors 0]] < 1.0e-7 &&
            [::embeddingBatch::maxAbsoluteDifference $decoded $numeric] < 1.0e-4
        }]
        binary scan [lindex $bytes 0] H8 firstHex
        set expectedHex [string range [binary encode hex [binary format r [lindex $decoded 0]]] 0 7]
        list $sizeOK $roundTrip [expr {$firstHex eq $expectedHex}] \
            [expr {abs([::embeddingBatch::norm $decoded] - 1.0) < 1.0e-5}]
    } finally {
        if {$context ne {}} {llama::context_free $context}
        llama::model_free $model
    }
} -result {1 1 1 1}

test embeddings-batch-native-1.3 {Empty lists are no-ops; invalid batches preserve context reuse} \
        -constraints embeddingModel -body {
    set model [llama::model_load $::env(TCLLLAMA_TEST_EMBEDDING_MODEL)]
    set context {}
    try {
        set context [llama::embedding_context_create $model 512 -options {
            pooling_type model attention_type model n_threads 2 n_batch 64 n_ubatch 16 n_seq_max 4
        }]
        set empty [llama::embed_batch $context {}]
        set tooMany [catch {llama::embed_batch $context [lrepeat 5 {small text}]}]
        set emptyText [catch {llama::embed_batch $context [list valid {}]}]
        set formatError [catch {llama::embed_batch $context {valid} -format native}]
        set overCapacity [catch {llama::embed_batch $context [lrepeat 4 {one two three four five six seven eight nine ten}]}]
        set afterError [llama::embed_batch $context [list {still works}]]
        set dimension [dict get [llama::info $context] model n_embd_out]
        list [llength $empty] $tooMany $emptyText $formatError $overCapacity \
            [expr {[llength $afterError] == 1 && [llength [lindex $afterError 0]] == $dimension}]
    } finally {
        if {$context ne {}} {llama::context_free $context}
        llama::model_free $model
    }
} -result {0 1 1 1 1 1}

test embeddings-batch-native-1.4 {Decoder-only causal contexts batch independent sequences} \
        -constraints decoderModel -body {
    set model [llama::model_load $::env(TCLLLAMA_TEST_DECODER_MODEL)]
    set context {}
    try {
        set context [llama::embedding_context_create $model 512 -options {
            pooling_type mean attention_type causal n_threads 2 n_threads_batch 2
            n_batch 64 n_ubatch 64 n_seq_max 2
        }]
        set texts [list {first decoder embedding} {another independent decoder sequence}]
        set actual [llama::embed_batch $context $texts]
        set expected [list [llama::embed $context [lindex $texts 0]] \
            [llama::embed $context [lindex $texts 1]]]
        set dimension [dict get [llama::info $context] model n_embd_out]
        set matches 1
        foreach one $actual two $expected {
            if {[llength $one] != $dimension ||
                [::embeddingBatch::maxAbsoluteDifference $one $two] > 1.0e-4} {set matches 0}
        }
        list [llength $actual] $dimension $matches [dict get [llama::info $context] n_past]
    } finally {
        if {$context ne {}} {llama::context_free $context}
        llama::model_free $model
    }
} -result {2 2048 1 0}

test embeddings-batch-native-1.5 {Batched and single embedding contexts sharing one model remain independent} \
        -constraints embeddingModel -body {
    set model [llama::model_load $::env(TCLLLAMA_TEST_EMBEDDING_MODEL)]
    set batchContext {}
    set singleContext {}
    try {
        set batchContext [llama::embedding_context_create $model 512 -options {
            pooling_type model attention_type model n_threads 2 n_batch 128 n_ubatch 128 n_seq_max 2
        }]
        set singleContext [llama::embedding_context_create $model 512 -options {
            pooling_type model attention_type model n_threads 1
        }]
        set refused [catch {llama::model_free $model}]
        set expected [llama::embed $singleContext {independent shared model context}]
        llama::embed_batch $batchContext {{separate first input} {separate second input}}
        llama::context_free $batchContext
        set batchContext {}
        set actual [llama::embed $singleContext {independent shared model context}]
        list $refused [expr {[::embeddingBatch::maxAbsoluteDifference $expected $actual] < 1.0e-5}]
    } finally {
        if {$batchContext ne {}} {llama::context_free $batchContext}
        if {$singleContext ne {}} {llama::context_free $singleContext}
        llama::model_free $model
    }
} -result {1 1}

::tcltest::cleanupTests
