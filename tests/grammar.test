#!/usr/bin/env tclsh
# grammar.test -- GBNF, streaming and snapshot regressions for a local GGUF.
# Usage: TCLLLAMA_TEST_MODEL=/path/model.gguf tclsh tests/grammar.test build/local
# Requires Tcl 8.6, tcltest and a locally built tclllama package.
set packageDir [file normalize [expr {$argc ? [lindex $argv 0] : "build/local"}]]
set argv {}
set argc 0
package require tcltest 2
namespace import ::tcltest::test
lappend auto_path $packageDir
package require tclllama 0.1.0
::tcltest::testConstraint model [expr {[info exists ::env(TCLLLAMA_TEST_MODEL)] && [file isfile $::env(TCLLLAMA_TEST_MODEL)]}]

# Collect callback fragments for comparison with the returned text.
proc grammarCollect {text} {
    append ::grammarOutput $text
}

test grammar-1.1 {Constrained generate, persistence, reset and invalid grammar} -constraints model -body {
    set h [llama::init $::env(TCLLLAMA_TEST_MODEL) 512 -options {n_threads 2 n_threads_batch 2}]
    try {
        set rule {root ::= "yes" | "no"}
        set first [llama::generate $h Hello -reset 1 -options [list grammar $rule temperature 0] -max_tokens 12]
        set before [llama::get_context $h]
        set bad [catch {llama::generate $h Hello -options {grammar {root ::= (}}} message]
        set same [expr {$before == [llama::get_context $h]}]
        set second [llama::generate $h Hello -reset 1 -max_tokens 12]
        list [expr {$first in {yes no}}] $bad $same [expr {$second in {yes no}}]
    } finally {llama::free $h}
} -result {1 1 1 1}

test grammar-1.2 {Literal stop marker is output and callback matches} -constraints model -body {
    set h [llama::init $::env(TCLLLAMA_TEST_MODEL) 512 -options {n_threads 2 n_threads_batch 2}]
    try {
        set ::grammarOutput {}
        set result [llama::generate $h Hello -options [list grammar {root ::= "<|im_end|>"} temperature 0] -max_tokens 20 -callback grammarCollect]
        list $result [expr {$result eq $::grammarOutput}]
    } finally {llama::free $h}
} -result {<|im_end|> 1}

test grammar-1.3 {Partial generation and snapshot restore grammar progress} -constraints model -body {
    set h [llama::init $::env(TCLLLAMA_TEST_MODEL) 512 -options {n_threads 2 n_threads_batch 2}]
    try {
        set rule {root ::= "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}
        set first [llama::generate $h Hello -options [list grammar $rule temperature 0] -max_tokens 1]
        llama::snapshot_save $h
        set a [llama::generate $h continue -max_tokens 3]
        llama::snapshot_restore $h
        set b [llama::generate $h continue -max_tokens 3]
        list [expr {[string length $first] < 40}] [expr {$a eq $b}] [expr {[string match a* $first]}]
    } finally {llama::free $h}
} -result {1 1 1}

test grammar-1.4 {Chat and Mirostat obey simple grammar} -constraints model -body {
    set h [llama::init $::env(TCLLLAMA_TEST_MODEL) 512 -options {n_threads 2 n_threads_batch 2}]
    try {
        set results {}
        foreach m {0 1 2} {
            set reply [llama::chat $h [list [dict create role user content hello]] -options [list grammar {root ::= "yes" | "no"} mirostat $m temperature 0.8] -max_tokens 12]
            lappend results [expr {$reply in {yes no}}]
        }
        set results
    } finally {llama::free $h}
} -result {1 1 1}
set failed $::tcltest::numTests(Failed)
::tcltest::cleanupTests
exit [expr {$failed > 0}]
