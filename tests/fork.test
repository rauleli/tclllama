#!/usr/bin/env tclsh
# fork.test -- Native KV fork and independent continuation.
# Usage: TCLLLAMA_TEST_MODEL=/path/model.gguf tclsh tests/fork.test build/local
# Requires Tcl 8.6, tcltest, a built tclllama and a compatible local GGUF.
set packageDir [file normalize [expr {$argc ? [lindex $argv 0] : "build/local"}]]
set argv {}
set argc 0
package require tcltest 2
namespace import ::tcltest::test
lappend auto_path $packageDir
package require tclllama 7.5
::tcltest::testConstraint model [expr {[info exists ::env(TCLLLAMA_TEST_MODEL)] && [file isfile $::env(TCLLLAMA_TEST_MODEL)]}]

# Invoked by legacy streaming with a text fragment; records whether reentry
# was rejected. The generator ignores this callback's ordinary return value.
proc forkBusyCallback {fragment} {
    set ::forkBusy [catch {llama::sequence $::forkHandle fork 0 1} ::forkBusyMessage]
}

test fork-1.1 {Native prefix copy, independent generation and cleanup} -constraints model -body {
    set h [llama::init $::env(TCLLLAMA_TEST_MODEL) 512 -options {n_seq_max 2 sequence_sampling true n_threads 2 n_threads_batch 2 n_batch 32}]
    try {
        set tokens [llama::tokenize $h {Hello world}]
        set n [llama::sequence $h prefill 0 $tokens]
        set f [llama::sequence $h fork 0 1]
        set pending [catch {llama::sequence $h delete 1}]
        set info [llama::sequence $h info 1]
        set opts [dict create seed 123 temperature 0.8 grammar {root ::= [0-9]{40}}]
        set a [llama::sequence $h generate 0 -options $opts -max_tokens 3]
        set b [llama::sequence $h generate 1 -options $opts -max_tokens 3]
        set rejected [catch {llama::sequence $h fork 0 1}]
        set before [llama::sequence $h info 0]
        llama::sequence $h delete 1
        set unaffected [expr {$before eq [llama::sequence $h info 0]}]
        llama::clear_cache $h
        list $f $pending [expr {[dict get $info n_past] == $n && [dict get $info pos_max] == $n-1}] \
            [expr {[llength $a] > 0 && $a eq $b}] $rejected $unaffected [llama::get_context $h]
    } finally {llama::free $h}
} -result {1 1 1 1 1 1 0}

test fork-1.2 {Source can be deleted after materialization; sampling prevents later fork} -constraints model -body {
    set h [llama::init $::env(TCLLLAMA_TEST_MODEL) 512 -options {n_seq_max 3 sequence_sampling true n_threads 2 n_threads_batch 2 n_batch 32}]
    try {
        llama::sequence $h create 1
        set t [llama::tokenize $h Hello]
        llama::sequence $h prefill 1 $t
        llama::sequence $h fork 1 2
        set opts [dict create seed 3 temperature 0 grammar {root ::= [0-9]{40}}]
        set first [llama::sequence $h generate 1 -options $opts -max_tokens 2]
        set invalid [catch {llama::sequence $h fork 1 0}]
        llama::sequence $h delete 1
        set second [llama::sequence $h generate 2 -options $opts -max_tokens 2]
        llama::sequence $h create 1
        set blocked [catch {llama::sequence $h fork 2 1}]
        list [expr {[llength $first] > 0 && $first eq $second}] $invalid $blocked
    } finally {llama::free $h}
} -result {1 1 1}

test fork-1.3 {Invalid sources, destinations and empty prefix} -constraints model -body {
    set h [llama::init $::env(TCLLLAMA_TEST_MODEL) 512 -options {n_seq_max 2 n_threads 2 n_threads_batch 2}]
    try {
        set errors {}
        foreach args {{0 1} {1 0} {-1 1} {0 -1} {0 2} {0 abc} {0 0}} {
            lappend errors [catch {llama::sequence $h fork {*}$args}]
        }
        list $errors [llama::get_context $h]
    } finally {llama::free $h}
} -result {{1 1 1 1 1 1 1} 0}

test fork-1.4 {Callback cannot reenter a busy handle} -constraints model -body {
    set h [llama::init $::env(TCLLLAMA_TEST_MODEL) 512 -options {n_threads 2 n_threads_batch 2}]
    try {
        set ::forkHandle $h
        set ::forkBusy 0
        llama::generate $h Hello -max_tokens 4 -callback forkBusyCallback
        list $::forkBusy $::forkBusyMessage
    } finally {llama::free $h}
} -result {1 {Handle is busy}}

test fork-1.5 {Prefill-only mode continues each branch independently} -constraints model -body {
    set h [llama::init $::env(TCLLLAMA_TEST_MODEL) 512 -options {n_seq_max 2 n_threads 2 n_threads_batch 2 n_batch 32}]
    try {
        set n [llama::sequence $h prefill 0 [llama::tokenize $h Hello]]
        llama::sequence $h fork 0 1
        llama::sequence $h prefill 1 {1}
        set first [llama::sequence $h info 0]
        set second [llama::sequence $h info 1]
        llama::sequence $h prefill 0 {1 1}
        list [expr {[dict get $first n_past] == $n}] \
            [expr {[dict get $second n_past] == $n+1}] \
            [expr {[dict get [llama::sequence $h info 0] n_past] == $n+2}] \
            [expr {$second eq [llama::sequence $h info 1]}]
    } finally {llama::free $h}
} -result {1 1 1 1}

test fork-1.6 {Persistent options and cached logits are inherited before sampling} -constraints model -body {
    set h [llama::init $::env(TCLLLAMA_TEST_MODEL) 512 -options {n_seq_max 2 sequence_sampling true n_threads 2 n_threads_batch 2 n_batch 32}]
    try {
        set tokens [llama::tokenize $h Hello]
        llama::sequence $h prefill 0 $tokens
        set opts [dict create seed 21 temperature 0.8 grammar {root ::= [0-9]{40}}]
        llama::sequence $h generate 0 -options $opts -max_tokens 1
        llama::clear_cache $h
        llama::sequence $h prefill 0 $tokens
        llama::sequence $h fork 0 1
        set a [llama::sequence $h generate 0 -max_tokens 3]
        set b [llama::sequence $h generate 1 -max_tokens 3]
        list [expr {[llength $a] > 0 && $a eq $b}] [regexp {^[0-9]+$} [llama::detokenize $h $b]]
    } finally {llama::free $h}
} -result {1 1}

set failed $::tcltest::numTests(Failed)
::tcltest::cleanupTests
exit [expr {$failed > 0}]
