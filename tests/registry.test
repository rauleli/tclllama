#!/usr/bin/env tclsh
# -----------------------------------------------------------------------------
# registry.test -- Offline model-store manifest and blob checks
#
# Purpose: verify local manifest lookup, GGUF blob resolution, cached blob
#          integrity, shared-blob deletion, and safe handling of missing data.
# API under test: library/ollama_registry.tcl; no registry requests are made.
# Requirements: Tcl 8.6, tcltest, tcllib http/tls/sha256/json packages.
# All filesystem changes are confined to a temporary directory.
# -----------------------------------------------------------------------------

set repoRoot [file normalize [file join [file dirname [info script]] ..]]
# The shared lab runner supplies a package directory to every suite. This
# offline utility suite does not load tclllama, so consume and ignore it before
# Tcltest parses its own command-line options.
set argv {}
set argc 0
package require tcltest 2
namespace import ::tcltest::test
source [file join $repoRoot library ollama_registry.tcl]

set store [file normalize [file join [pwd] registry-test-[pid]]]
file delete -force $store
set ::ollama_registry::models_dir $store
set ::ollama_registry::verbose 0
::ollama_registry::init_storage

# Write one minimal OCI/Ollama-style manifest referencing the provided blobs.
proc registryTestWriteManifest {model tag digest size} {
    set directory [file join $::ollama_registry::models_dir manifests library $model]
    file mkdir $directory
    set manifest [format {"schemaVersion":2,"config":{"digest":"sha256:%s","size":1},"layers":[{"mediaType":"application/vnd.ollama.image.model","digest":"sha256:%s","size":%d}]} \
        $digest $digest $size]
    set channel [open [file join $directory $tag] w]
    try {
        puts $channel "\{$manifest\}"
    } finally {
        close $channel
    }
}

set correctBytes right
set correctHash [::sha2::sha256 $correctBytes]
set blobName "sha256-$correctHash"
set blobPath [file join $store blobs $blobName]
set channel [open $blobPath w]
fconfigure $channel -translation binary
puts -nonewline $channel $correctBytes
close $channel
registryTestWriteManifest fixture latest $correctHash [string length $correctBytes]

test registry-1.1 {model listing and resolver use manifest blob digest without suffix assumptions} -body {
    list [::ollama_registry::list_local_models] \
        [::ollama_registry::get_model_path fixture:latest]
} -result [list {fixture:latest} $blobPath]

test registry-1.2 {existing correctly hashed cached blob is reused offline} -body {
    ::ollama_registry::download_blob fixture "sha256:$correctHash" [string length $correctBytes]
} -result $blobPath

test registry-1.3 {same-size corrupt cached blob is rejected and preserved} -body {
    set channel [open $blobPath w]
    fconfigure $channel -translation binary
    puts -nonewline $channel wrong
    close $channel
    set code [catch {
        ::ollama_registry::download_blob fixture "sha256:$correctHash" [string length $correctBytes]
    } message]
    list $code [file exists $blobPath] [string match {*checksum*} [string tolower $message]] \
        [::ollama_registry::sha256_file $blobPath]
} -result [list 1 1 1 [::sha2::sha256 wrong]]

test registry-1.4 {deleting one manifest preserves a blob referenced by another manifest} -body {
    registryTestWriteManifest second stable $correctHash [string length $correctBytes]
    set deleted [::ollama_registry::delete_model fixture:latest]
    list $deleted [file exists $blobPath] [::ollama_registry::list_local_models]
} -result [list 1 1 {second:stable}]

test registry-1.5 {missing manifest and missing model blob report errors} -body {
    registryTestWriteManifest empty latest [::sha2::sha256 absent] 6
    list [catch {::ollama_registry::get_model_path missing:latest}] \
        [catch {::ollama_registry::get_model_path empty:latest}]
} -result {1 1}

file delete -force $store
::tcltest::cleanupTests
exit [expr {$::tcltest::numTests(Failed) > 0}]
