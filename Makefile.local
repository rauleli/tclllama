# Local Linux build against a static, PIC-enabled llama.cpp build.
LLAMA_DIR ?= ../dependencias/llama.cpp
LLAMA_BUILD ?= $(LLAMA_DIR)/build-1719dbb-static-pic
TCL_INCLUDE ?= /opt/ActiveTcl-8.6/include
BUILD_DIR ?= build/local
CXX ?= c++
CPPFLAGS += -I$(TCL_INCLUDE) -I$(LLAMA_DIR)/include -I$(LLAMA_DIR)/ggml/include
CPPFLAGS += -I$(LLAMA_DIR)/common -I$(LLAMA_DIR)/vendor
SCHEMA_NAMES = json json-schema json-schema-to-grammar unicode common trie
SCHEMA_OBJECTS = $(addprefix $(BUILD_DIR)/native-,$(addsuffix .o,$(SCHEMA_NAMES))) $(BUILD_DIR)/schema_adapter.o
CXXFLAGS ?= -O2
LLAMA_ARCHIVES = $(LLAMA_BUILD)/src/libllama.a $(LLAMA_BUILD)/ggml/src/libggml.a $(LLAMA_BUILD)/ggml/src/libggml-cpu.a $(LLAMA_BUILD)/ggml/src/libggml-base.a

.PHONY: all sampler-history-test logit-bias-test sampling-strategies-test
all: $(BUILD_DIR)/tclllama.so $(BUILD_DIR)/pkgIndex.tcl

.PHONY: schema-adapter-test
schema-adapter-test: $(BUILD_DIR)/schema-adapter-test
	$(BUILD_DIR)/schema-adapter-test

$(BUILD_DIR)/schema-adapter-test: tests/schema_adapter.cpp $(SCHEMA_OBJECTS) $(LLAMA_ARCHIVES) | $(BUILD_DIR)
	$(CXX) $(CPPFLAGS) -std=c++17 -Wl,--gc-sections "$<" $(SCHEMA_OBJECTS) -Wl,--start-group $(LLAMA_ARCHIVES) -Wl,--end-group -fopenmp -ldl -lpthread -lm -o "$@"

# Synthetic native sampler history regression; no model is required.
sampler-history-test: $(BUILD_DIR)/sampler-history-test
	$(BUILD_DIR)/sampler-history-test

logit-bias-test: $(BUILD_DIR)/logit-bias-test
	$(BUILD_DIR)/logit-bias-test

sampling-strategies-test: $(BUILD_DIR)/sampling-strategies-test
	$(BUILD_DIR)/sampling-strategies-test

$(BUILD_DIR)/sampler-history-test: tests/sampler_history.cpp $(LLAMA_ARCHIVES) | $(BUILD_DIR)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -std=c++11 "$<" -Wl,--start-group $(LLAMA_ARCHIVES) -Wl,--end-group -fopenmp -ldl -lpthread -lm -o "$@"

$(BUILD_DIR)/logit-bias-test: tests/logit_bias.cpp generic/sampling_guard.h $(LLAMA_ARCHIVES) | $(BUILD_DIR)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -std=c++11 "$<" -Wl,--start-group $(LLAMA_ARCHIVES) -Wl,--end-group -fopenmp -ldl -lpthread -lm -o "$@"

$(BUILD_DIR)/sampling-strategies-test: tests/sampling_strategies.cpp $(LLAMA_ARCHIVES) | $(BUILD_DIR)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -std=c++11 "$<" -Wl,--start-group $(LLAMA_ARCHIVES) -Wl,--end-group -fopenmp -ldl -lpthread -lm -o "$@"

$(BUILD_DIR):
	mkdir -p "$@"

$(BUILD_DIR)/tclllama.o: generic/tclllama.c generic/stream_buffer.h generic/sampling_guard.h generic/schema_adapter.h | $(BUILD_DIR)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -std=c++11 -fPIC -x c++ -c "$<" -o "$@"

$(BUILD_DIR)/native-%.o: $(LLAMA_DIR)/common/%.cpp | $(BUILD_DIR)
	$(CXX) $(CPPFLAGS) -O1 -std=c++17 -fPIC -fvisibility=hidden -ffunction-sections -fdata-sections -c "$<" -o "$@"

$(BUILD_DIR)/schema_adapter.o: generic/schema_adapter.cpp generic/schema_adapter.h | $(BUILD_DIR)
	$(CXX) $(CPPFLAGS) -O1 -std=c++17 -fPIC -c "$<" -o "$@"

$(BUILD_DIR)/tclllama.so: $(BUILD_DIR)/tclllama.o $(SCHEMA_OBJECTS) $(LLAMA_ARCHIVES)
	$(CXX) -shared -Wl,--gc-sections -o "$@" $(BUILD_DIR)/tclllama.o $(SCHEMA_OBJECTS) -Wl,--start-group $(LLAMA_ARCHIVES) -Wl,--end-group -fopenmp -ldl -lpthread -lm

$(BUILD_DIR)/pkgIndex.tcl: | $(BUILD_DIR)
	printf '%s\n' 'package ifneeded tclllama 7.5 [list load [file join $$dir tclllama.so] Tclllama]' > "$@"
