# Makefile.in for the TEA build of tclllama.
# configure supplies Tcl paths and the selected llama.cpp source/build trees.

srcdir = @srcdir@
prefix = @prefix@
exec_prefix = @exec_prefix@
libdir = @libdir@
PACKAGE_NAME = @PACKAGE_NAME@
PACKAGE_VERSION = @PACKAGE_VERSION@
TCL_INCLUDE_SPEC = @TCL_INCLUDE_SPEC@
TCL_STUB_LIB_SPEC = @TCL_STUB_LIB_SPEC@
TCL_SHLIB_SUFFIX = @TCL_SHLIB_SUFFIX@
LLAMA_INCLUDES = @LLAMA_INCLUDES@
LLAMA_DIR = @LLAMA_DIR@
LLAMA_ARCHIVES = @LLAMA_ARCHIVES@
CFLAGS = @CFLAGS@
CFLAGS_DEFAULT = @CFLAGS_DEFAULT@
CFLAGS_WARNING = @CFLAGS_WARNING@
SHLIB_CFLAGS = @SHLIB_CFLAGS@
PKG_CFLAGS = @PKG_CFLAGS@
CPPFLAGS = @CPPFLAGS@
LDFLAGS = @LDFLAGS@
LIBS = @LIBS@
CXX = @CXX@
SHLIB_LD = @SHLIB_LD@
PKG_LIB_FILE = @PKG_LIB_FILE@

BUILD_DIR = .
PKG_INSTALL_DIR = $(DESTDIR)$(libdir)/$(PACKAGE_NAME)$(PACKAGE_VERSION)
SHLIB = $(PKG_LIB_FILE)

SCHEMA_NAMES = json json-schema json-schema-to-grammar unicode common trie
SCHEMA_OBJS = $(addprefix $(BUILD_DIR)/native-,$(addsuffix .o,$(SCHEMA_NAMES)))
OBJS = $(BUILD_DIR)/tclllama.o $(BUILD_DIR)/sha256.o \
	$(SCHEMA_OBJS) $(BUILD_DIR)/schema_adapter.o

COMMON_FLAGS = $(CPPFLAGS) $(CFLAGS) $(PKG_CFLAGS) \
	-DUSE_TCL_STUBS $(TCL_INCLUDE_SPEC) \
	$(LLAMA_INCLUDES) $(SHLIB_CFLAGS)
ENGINE_LIBS = -Wl,--start-group $(LLAMA_ARCHIVES) -Wl,--end-group \
	-fopenmp -ldl -lpthread -lm -lcrypto

all: $(SHLIB) pkgIndex.tcl

$(SHLIB): $(OBJS) $(LLAMA_ARCHIVES)
	$(CXX) -shared $(LDFLAGS) -Wl,--gc-sections -o $@ $(OBJS) \
		$(TCL_STUB_LIB_SPEC) $(LIBS) $(ENGINE_LIBS)

$(BUILD_DIR)/tclllama.o: $(srcdir)/generic/tclllama.c \
		$(srcdir)/generic/stream_buffer.h $(srcdir)/generic/sampling_guard.h \
		$(srcdir)/generic/schema_adapter.h
	$(CXX) $(COMMON_FLAGS) -std=c++11 -x c++ -c $< -o $@

$(BUILD_DIR)/sha256.o: $(srcdir)/generic/sha256.c
	$(CXX) $(COMMON_FLAGS) -x c++ -c $< -o $@

$(BUILD_DIR)/native-%.o: $(LLAMA_DIR)/common/%.cpp
	$(CXX) $(COMMON_FLAGS) -O1 -std=c++17 -fvisibility=hidden \
		-ffunction-sections -fdata-sections -c $< -o $@

$(BUILD_DIR)/schema_adapter.o: $(srcdir)/generic/schema_adapter.cpp \
		$(srcdir)/generic/schema_adapter.h
	$(CXX) $(COMMON_FLAGS) -O1 -std=c++17 -c $< -o $@

install: all
	install -d $(PKG_INSTALL_DIR)
	install -m 755 $(SHLIB) $(PKG_INSTALL_DIR)/$(SHLIB)
	install -m 644 pkgIndex.tcl $(PKG_INSTALL_DIR)/pkgIndex.tcl
	install -m 644 $(srcdir)/library/*.tcl $(PKG_INSTALL_DIR)/

uninstall:
	rm -f $(PKG_INSTALL_DIR)/$(SHLIB) $(PKG_INSTALL_DIR)/pkgIndex.tcl
	for file in $(srcdir)/library/*.tcl; do \
		name=$${file##*/}; rm -f $(PKG_INSTALL_DIR)/$$name; \
	done
	-rmdir $(PKG_INSTALL_DIR) 2>/dev/null || true

clean:
	rm -f $(OBJS) $(SHLIB)

distclean: clean
	rm -f Makefile pkgIndex.tcl config.status config.log config.cache

help:
	@echo "Targets: all, install, uninstall, clean, distclean"

.PHONY: all install uninstall clean distclean help
